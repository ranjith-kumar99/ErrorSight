<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Realistic application code, instrumented by the real ExceptionLens build targets exactly as a
    consumer of the NuGet package would be — except that the weaver comes from this repository.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>SampleApp</RootNamespace>
    <ExceptionLensWeaverPath>$(MSBuildThisFileDirectory)..\..\src\ExceptionLens.Weaver\bin\$(Configuration)\net8.0\ExceptionLens.Weaver.dll</ExceptionLensWeaverPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ExceptionLens\ExceptionLens.csproj" />
    <ProjectReference Include="..\..\src\ExceptionLens.Weaver\ExceptionLens.Weaver.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\..\src\ExceptionLens\build\ExceptionLens.targets" />

</Project>
